/* SVG CHART HELPERS */

function barChart(elementId, data, options = {}) {

  const svg = document.getElementById(elementId);

  if (!svg) return;

  const width = options.width || 500;
  const height = options.height || 270;
  const left = 125;
  const right = 25;
  const top = 20;
  const row = 35;
  const max = options.max || 100;

  svg.setAttribute("viewBox", `0 0 ${width} ${height}`);

  let html = "";

  data.forEach((item, index) => {

    const y = top + index * row;
    const barWidth = (item.value / max) * (width - left - right);

    html += `
      <text x="5" y="${y + 16}" class="chart-label">
        ${item.name}
      </text>

      <rect x="${left}" y="${y}"
        width="${width - left - right}"
        height="19" rx="5" fill="#edf2f9"/>

      <rect x="${left}" y="${y}"
        width="${barWidth}" height="19"
        rx="5" fill="#2563eb"/>

      <text x="${left + barWidth + 7}" y="${y + 15}"
        class="chart-label">${item.value}</text>
    `;

  });

  svg.innerHTML = html;
}


